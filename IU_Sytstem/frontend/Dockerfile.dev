FROM node:22-alpine

WORKDIR /app

# Install system dependencies needed by native modules (rarely needed for Vite)
RUN apk add --no-cache libc6-compat

# Copy package manifests first for better layer caching
COPY package*.json ./

# Install dependencies at build time so the image has a usable baseline
RUN npm install --no-audit --no-fund

# Copy source
COPY . .

# Expose Vite dev port
EXPOSE 5173

# Vite needs to bind 0.0.0.0 to be reachable from outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]